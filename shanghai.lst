30C9 CA02             (     shanghai.asm):03775          ORB #2
30CB F7FF20           (     shanghai.asm):03776          STB  $FF20   SAVE SET PORT
30CE 4C               (     shanghai.asm):03777          INCA         MAKE DELAY LONGER
30CF 814C             (     shanghai.asm):03778          CMPA #76     ALL DONE?
30D1 25EF             (     shanghai.asm):03779          BLO  A@      NO, LOOP BACK
                      (     shanghai.asm):03780         
30D3                  (     shanghai.asm):03781         SNDOFF
30D3 17FAC7           (     shanghai.asm):03782          LBSR SOFF
30D6 5F               (     shanghai.asm):03783          CLRB        MAKE RETURN ZERO
