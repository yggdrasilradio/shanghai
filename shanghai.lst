                      (     shanghai.asm):03725         
3086                  (     shanghai.asm):03726         PING
3086 8D51             (     shanghai.asm):03727          BSR  SNDON GET SOUND FROM 6 BIT DAC
3088 3401             (     shanghai.asm):03728          PSHS CC    SAVE IRQ FLAGS
308A 1A50             (     shanghai.asm):03729          ORCC #$50  TURN OFF IRQS
308C 86E6             (     shanghai.asm):03730          LDA #230   HOW LONG TO DO SOUND
308E                  (     shanghai.asm):03731         A@
308E 8D18             (     shanghai.asm):03732          BSR  B@    DO A TIME DELAY
                      (     shanghai.asm):03733         *
3090 1F89             (     shanghai.asm):03734          TFR  A,B   GET TIME COUNT
3092 C4F7             (     shanghai.asm):03735          ANDB #$F7  USE ONLY THE TOP 5 BITS
3094 CA02             (     shanghai.asm):03736          ORB  #2    SET PRINTER BIT HIGH
3096 F7FF20           (     shanghai.asm):03737          STB  $FF20 SEND IT OUT THE DAC PORT
                      (     shanghai.asm):03738         *
3099 8D0D             (     shanghai.asm):03739          BSR  B@    DO A TIME DELAY
309B C602             (     shanghai.asm):03740          LDB  #2    CLEAR ALL BITS BUT PRINTER
309D F7FF20           (     shanghai.asm):03741          STB  $FF20 ON DAC PORT
30A0 4A               (     shanghai.asm):03742          DECA       MAKE BELL SOUND SMALLER
30A1 4A               (     shanghai.asm):03743          DECA       BY 2
30A2 8112             (     shanghai.asm):03744          CMPA #18   IS BELL DONE?
30A4 24E8             (     shanghai.asm):03745          BHS  A@    NO, THEN LOOP
30A6 3501             (     shanghai.asm):03746          PULS CC    TURN ON IRQS
                      (     shanghai.asm):03747         *
30A8                  (     shanghai.asm):03748         B@
30A8 C6B4             (     shanghai.asm):03749          LDB #180   TIME DELAY USED BY PING
30AA                  (     shanghai.asm):03750         C@
30AA 5A               (     shanghai.asm):03751          DECB
30AB 26FD             (     shanghai.asm):03752          BNE C@
30AD 39               (     shanghai.asm):03753          RTS
